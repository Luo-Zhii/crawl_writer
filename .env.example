# Copy to .env and fill in what you need. All values are optional.

# Where the SQLite db, chapter files and exports live.
# CRAWLW_DATA_DIR=/home/you/novels

# Politeness knobs. Raise the delay if a site starts throwing 403.
# CRAWLW_PER_DOMAIN_DELAY=0.6
# CRAWLW_PER_DOMAIN_CONCURRENCY=4
# CRAWLW_REQUEST_TIMEOUT=30

# Proxy for geo-blocked sites (most Chinese raw sites need one from abroad).
# CRAWLW_PROXY=http://127.0.0.1:1080

# Translation provider keys. Google Translate (free endpoint) needs no key and
# is the default; these are for the LLM providers.
# CRAWLW_GEMINI_API_KEY=
# CRAWLW_OPENAI_API_KEY=
# CRAWLW_ANTHROPIC_API_KEY=
